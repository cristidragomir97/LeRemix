<?xml version="1.0" ?>
<!--
  LLMy — URDF for the canvas-design robot, ported into the llmy_root contract
  so that sibling packages (llmy_control, llmy_moveit, llmy_servo_manager,
  llmy_slam, llmy_nav, ...) keep working without modification.

  External names preserved from the original /home/cdr/LLMy llmy_description:
    joints:  1..6, tilt, right_wheel_joint, left_wheel_joint
             (pan removed — canvas design has no pan servo)
    arm links:  arm_base_1, arm_base_rotation_servo_1, arm_base_rotation_link_1,
                arm_shoulder_servo_1, arm_shoulder_link_1, arm_elbow_servo_1,
                arm_elbow_link_1, arm_wrist_tilt_servo_1, arm_wrist_link_1,
                arm_wrist_roll_servo_1, arm_gripper_1, arm_gripper_servo_1, arm_jaw_1
    sensors:    head_camera_1, imu_1, lidar_1, wrist_camera_v1_1
    drive:      wheel_{left,right}_1, {left,right}_motor_1, {left,right}_motor_mount_1
    frames:     base_link, base_footprint, lidar_frame, imu_frame,
                head_camera_frame, wrist_camera_frame

  Visual origins are non-zero per-link: they are the mesh-centering offsets
  for the Fusion-exported STLs (whose vertex data sits in a shared world frame
  rooted at base_link).  See the canvas package for the derivation.

  Kinematic tree:
  - base_link
     -[left_motor_mount_1_joint]-> left_motor_mount_1
       -[left_motor_1_joint]-> left_motor_1
         -[left_wheel_joint (continuous)]-> wheel_left_1
     -[right_motor_mount_1_joint]-> right_motor_mount_1
       -[right_motor_1_joint]-> right_motor_1
         -[right_wheel_joint (continuous)]-> wheel_right_1
     -[left_baseus_mount_v1_1_joint]-> left_baseus_mount_v1_1
     -[frame_short_right_joint]-> frame_short_right
     -[frame_tall_fr_joint]-> frame_tall_fr
       -[frame_corner_fr_joint]-> frame_corner_fr
     -[frame_tall_br_joint]-> frame_tall_br
       -[modular_floor_joint]-> modular_floor
         -[electronics_holder_left_joint]-> electronics_holder_left
           -[electronics_pcb_joint]-> electronics_pcb
             -[imu_1_joint]-> imu_1
         -[electronics_holder_right_joint]-> electronics_holder_right
       -[frame_corner_br_joint]-> frame_corner_br
         -[frame_top_right_joint]-> frame_top_right
     -[frame_tall_bl_joint]-> frame_tall_bl
       -[frame_corner_bl_joint]-> frame_corner_bl
         -[frame_top_back_joint]-> frame_top_back
     -[frame_tall_fl_joint]-> frame_tall_fl
       -[frame_corner_fl_joint]-> frame_corner_fl
         -[frame_top_front_joint]-> frame_top_front
           -[support_v1_1_joint]-> support_v1_1
             -[tilt_servo_1_joint]-> tilt_servo_1
               -[tilt (continuous)]-> realsense_support_v1_1
                 -[head_camera_1_joint]-> head_camera_1
         -[frame_top_left_joint]-> frame_top_left
     -[frame_short_left_joint]-> frame_short_left
       -[arm_deck_joint]-> arm_deck
         -[arm_base_1_joint]-> arm_base_1
           -[arm_base_rotation_servo_1_joint]-> arm_base_rotation_servo_1
             -[1 (continuous)]-> arm_base_rotation_link_1
               -[arm_shoulder_servo_1_joint]-> arm_shoulder_servo_1
                 -[2 (continuous)]-> arm_shoulder_link_1
                   -[arm_elbow_servo_1_joint]-> arm_elbow_servo_1
                     -[3 (continuous)]-> arm_elbow_link_1
                       -[arm_wrist_tilt_servo_1_joint]-> arm_wrist_tilt_servo_1
                         -[4 (continuous)]-> arm_wrist_link_1
                           -[arm_wrist_roll_servo_1_joint]-> arm_wrist_roll_servo_1
                             -[5 (continuous)]-> arm_gripper_1
                               -[arm_gripper_servo_1_joint]-> arm_gripper_servo_1
                                 -[6 (continuous)]-> arm_jaw_1
                               -[wrist_camera_mount_1_joint]-> wrist_camera_mount_1
                                 -[wrist_camera_v1_1_joint]-> wrist_camera_v1_1
               -[arm_base_rotation_link_cover_1_joint]-> arm_base_rotation_link_cover_1
     -[right_caster_1_joint]-> right_caster_1
     -[left_caster_1_joint]-> left_caster_1
     -[llmy_lidar_base_v1_1_joint]-> llmy_lidar_base_v1_1
       -[lidar_1_joint]-> lidar_1
     -[right_baseus_mount_v1_1_joint]-> right_baseus_mount_v1_1
-->
<robot name="llmy_root" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- use_sim: when true, pulls in Gazebo ros2_control + sdf extensions.
       Hardware launches should override to false. -->
  <xacro:arg name="use_sim" default="true"/>

  <xacro:include filename="$(find llmy_description)/urdf/materials.xacro" />
  <xacro:if value="$(arg use_sim)">
    <xacro:include filename="$(find llmy_description)/urdf/LLMy.ros2control" />
    <xacro:include filename="$(find llmy_description)/urdf/LLMy.gazebo" />
  </xacro:if>
  <!-- ========================================== LINKS ==========================================-->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.003179 -0.000009 0.005401" rpy="0 0 0"/>
      <mass value="2.227457140108448"/>
      <inertia ixx="0.010888" iyy="0.009782" izz="0.020514" ixy="-5e-06" iyz="0.0" ixz="-3.3e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find llmy_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="nylon_darkgrey"/>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find llmy_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

