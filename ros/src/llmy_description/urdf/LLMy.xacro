    <child link="arm_gripper_1"/>
    <axis xyz="-0.637083 0.000000 0.770795"/>
    <limit lower="-1.04" upper="3.14" effort="20.0" velocity="5.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <joint name="arm_gripper_servo_1_joint" type="fixed">
    <origin xyz="0.020536 0.011900 0.000269" rpy="0.000000 0.000000 0.000000"/>
    <parent link="arm_gripper_1"/>
    <child link="arm_gripper_servo_1"/>
  </joint>

  <joint name="6" type="revolute">
    <origin xyz="-0.020140 0.008300 -0.029943" rpy="0.000000 0.000000 0.000000"/>
    <parent link="arm_gripper_servo_1"/>
    <child link="arm_jaw_1"/>
    <axis xyz="0.770795 -0.000000 0.637083"/>
    <limit lower="0.0" upper="2.14" effort="20.0" velocity="5.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>


  <!-- ===== Virtual sensor frames (drivers / navigation reference these) ===== -->

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Lidar frame: rotated 180° around Z to flip scan direction -->
  <link name="lidar_frame"/>
  <joint name="lidar_frame_joint" type="fixed">
    <origin xyz="0.0 0.0 0.02" rpy="0 0 3.14159265359"/>
    <parent link="lidar_1"/>
    <child link="lidar_frame"/>
  </joint>

  <link name="imu_frame"/>
  <joint name="imu_frame_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <parent link="imu_1"/>
    <child link="imu_frame"/>
  </joint>

  <link name="head_camera_frame"/>
  <joint name="head_camera_frame_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <parent link="head_camera_1"/>
    <child link="head_camera_frame"/>
  </joint>

  <!-- Wrist camera frame: rotated 180° around X for standard ROS camera orientation -->
  <link name="wrist_camera_frame"/>
  <joint name="wrist_camera_frame_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="3.14159 0 0"/>
    <parent link="wrist_camera_v1_1"/>
    <child link="wrist_camera_frame"/>
  </joint>

</robot>
