<?xml version="1.0" ?>
<robot name="llmy_root" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

<!-- ros2_control plugin for Gazebo -->
<gazebo>
  <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find llmy_control)/config/controllers.sim.yaml</parameters>
  </plugin>
</gazebo>

  <!-- Per-link Gazebo materials, matching URDF <material> definitions. -->

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
