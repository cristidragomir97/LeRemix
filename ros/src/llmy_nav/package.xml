<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llmy_nav</name>
  <version>1.0.0</version>
  <description>Navigation package for LLMy robot - Nav2 configuration and mode management</description>

  <maintainer email="dev@llmy.dev">LLMy Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>lifecycle_msgs</depend>

  <!-- Nav2 dependencies -->
  <depend>nav2_map_server</depend>
  <depend>nav2_amcl</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_smac_planner</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_msgs</depend>

  <!-- SLAM -->
  <depend>slam_toolbox</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
